 "pronunciation": {"parser":"example.symbols.v1","candidates":true,"continuation":"-","phonemeSet":"example.multilingual.v1","phonemes":["l","a","n","i","h","ao","zh","ong","ch","k","o","s","e","t","hello","sil"],"dictionaries":["zh.json","ja.json","en.json"]},
 "synthesis": {"cancel":true,"concurrent":false,"segmented":false,"channels":2,"format":"float32"}
